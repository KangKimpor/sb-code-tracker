rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.adminUntil is number
        && request.auth.token.adminUntil > request.time.toMillis() / 1000;
    }
    match /codeInventory/{id} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 2000;
      allow write: if false;
    }
    match /codes/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /{collection}/{id} {
      allow read: if collection in ['activityLog', 'releaseHistory', 'topupRequests'] && admin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
