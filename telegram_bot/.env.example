# Set these on the bot host; do not put secrets in the website or in git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SingBuildBot
FIREBASE_PROJECT_ID=sb-code-tracker
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/tracker-service-account.json
ADMIN_PIN=
# Numeric Telegram IDs of people allowed to enter the admin PIN.
ADMIN_USER_IDS=
TRACKER_APP_URL=https://sb-code-tracker.web.app
# Omit WEBHOOK_URL for local long polling. Set the public HTTPS host for webhook mode.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=10000
